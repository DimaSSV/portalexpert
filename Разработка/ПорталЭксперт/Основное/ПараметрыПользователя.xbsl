@Обработчик
статический метод ВычислитьПараметрыРаботыКлиента(): ПараметрыПользователя.Параметры

    пер АктивныйПользователь: ОписаниеПользователяСервиса|Неопределено = ПользователиСервиса.ТекущийПользователь
    пер ТекущийПользователь: Пользователи.Ссылка? = Неопределено
    если АктивныйПользователь != Неопределено
        ТекущийПользователь = Пользователи.Найти(АктивныйПользователь.Ид)
    ;

    возврат новый ПараметрыПользователя.Параметры(
        ТекущийПользователь = ТекущийПользователь)

;
 