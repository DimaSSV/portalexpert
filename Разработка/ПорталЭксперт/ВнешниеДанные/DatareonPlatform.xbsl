
метод Сотрудники(Запрос: HttpСервисЗапрос)
    ОбработатьЗапрос(Запрос)
;

метод ОбработатьЗапрос(Запрос: HttpСервисЗапрос)
    знч Структура: Соответствие<Строка, Строка|Массив<Строка>>
    
    Структура.Вставить("ИмяСервиса", Запрос.ИмяСервиса)
    Структура.Вставить("ИмяШаблона", Запрос.ИмяШаблона)
    Структура.Вставить("Метод", Запрос.Метод)
    Структура.Вставить("ПутьКРесурсу", Запрос.ПутьКРесурсу)
    Структура.Вставить("Тело", Запрос.Тело.ПрочитатьКакСтроку())
    
    Запрос.Ответ.Заголовки.Добавить("Content-Type", "application/json")
    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Структура), "UTF-8")
;
