метод ИмяСотрудника(): Строка
    пер ФИО: Строка? = ДанныеСтроки.Данные.ФИОСотрудника
    если ФИО == Неопределено
        возврат "Сотрудник не указан"
    ;
    если ФИО == ""
        возврат "Сотрудник не указан"
    ;
    возврат ФИО
;

метод НомерИТип(): Строка
    пер ПредставлениеТипа = "Личный"
    если ДанныеСтроки.Данные.ТипНомера == ТипыТелефонныхНомеров.НомерРабочегоМеста
        ПредставлениеТипа = "Рабочий"
    ;
    возврат ДанныеСтроки.Данные.НомерТелефона + " · " + ПредставлениеТипа
;
