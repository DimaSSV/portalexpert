@Обработчик
метод ПослеСоздания()
    ЗаполнитьДанныеОтправлений()
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьОтправления(Маршрут: РасписаниеАвтобусов.Ссылка): Массив<РасписаниеАвтобусовКарточкаДанныеВремени>
    пер Отправления = новый Массив<РасписаниеАвтобусовКарточкаДанныеВремени>()
    пер МаршрутОбъект = Маршрут.ЗагрузитьОбъект()
    если МаршрутОбъект != Неопределено
        для Строка из МаршрутОбъект.Отправления
            Отправления.Добавить(новый РасписаниеАвтобусовКарточкаДанныеВремени(Строка.ВремяОтправления))
        ;
    ;
    возврат Отправления
;

метод ЗаполнитьДанныеОтправлений()
    пер МаршрутСсылка = ДанныеСтроки.Данные.Ссылка
    ДанныеОтправлений.Данные.Очистить()
    ДанныеОтправлений.Данные.ДобавитьВсе(ПолучитьОтправления(МаршрутСсылка))
;
